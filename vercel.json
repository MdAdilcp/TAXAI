{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "python -m pip install --break-system-packages -r backend/requirements-prod.txt",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "env": {
    "PYTHONUNBUFFERED": "1",
    "VITE_API_URL": "",
    "OPENROUTER_API_KEY": "",
    "OPENAI_API_KEY": "",
    "GEMINI_API_KEY": ""
  }
}
